# AssureSign SOAP Passthrough Configuration

# AssureSign API Configuration
ASSURESIGN_BASE_URL=https://api.assuresign.net
ASSURESIGN_SOAP_ENDPOINT=/v3.6/DocumentService.svc
ASSURESIGN_USERNAME=your_username_here
ASSURESIGN_PASSWORD=your_password_here
ASSURESIGN_API_KEY=your_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
REQUEST_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info